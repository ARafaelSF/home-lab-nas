# Dashboard (obrigatório com bind 0.0.0.0)
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=altere_esta_senha
HERMES_DASHBOARD_BASIC_AUTH_SECRET=string_de_32_caracteres_alfanumericos

# Home Assistant (opcional — token de longa duração)
HASS_URL=http://192.168.3.10:8123
HASS_TOKEN=

# Telegram — bot de monitorização e interação
# BotFather: https://t.me/BotFather | User ID: https://t.me/userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_HOME_CHANNEL=

# LLM — obrigatório para o bot responder no Telegram
# Crie em: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modelo actual no Hermes: anthropic/claude-opus-4.6 (via OpenRouter)
# Alternativa mais barata: anthropic/claude-sonnet-4  (mudar no dashboard :9119)
