      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "ping_rtt_std_deviation_seconds * 1000",
          "legendFormat": "{{target}}",
          "refId": "A",
          "datasource": {
