  "panels": [
    {
      "type": "text",
      "title": "Sobre este dashboard",
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**O quê:** qualidade da internet vista do NAS (latência, perda, DNS, HTTP, speedtest e uso do `eth0`).\n\n**Quando usar:** internet lenta, DNS falhando, ou comparar horário do speedtest com reclamações.\n\n**Nota:** painéis `bb …` vêm do blackbox; os outros do ping-exporter. Speedtest não é contínuo."
      }
    },
    {
      "title": "Latência ICMP (ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "ping_rtt_mean_seconds * 1000",
          "legendFormat": "{{target}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "expr": "avg by (instance) (probe_duration_seconds{job=\"blackbox-icmp\"}) * 1000",
          "legendFormat": "bb {{instance}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 1
        }
      }
    },
    {
      "title": "Perda de pacotes (%)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "expr": "ping_loss_ratio * 100",
          "legendFormat": "{{target}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        },
        {
          "expr": "(1 - avg by (instance) (probe_success{job=\"blackbox-icmp\"})) * 100",
          "legendFormat": "bb {{instance}}",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100
        }
      }
    },
    {
      "title": "Jitter ICMP (ms)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
