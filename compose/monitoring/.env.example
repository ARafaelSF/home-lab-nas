GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# InfluxDB 2.x — org homelab; bucket home_energy = dados HA; monitoring = reservado
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=CHANGE_ME
INFLUXDB_ADMIN_TOKEN=CHANGE_ME_64_HEX
INFLUXDB_HA_WRITE_TOKEN=CHANGE_ME_64_HEX
INFLUXDB_GRAFANA_READ_TOKEN=CHANGE_ME_64_HEX
INFLUXDB_ORG=homelab
INFLUXDB_DEFAULT_BUCKET=monitoring
INFLUXDB_HA_BUCKET=home_energy

# Retenção Prometheus: tempo + tecto de tamanho (o que ocorrer primeiro apaga)
# ~45 MB/dia → 365d ≈ 17 GB
PROMETHEUS_RETENTION=90d
PROMETHEUS_RETENTION_SIZE=40GB

# Tags (digest via WUD)
INFLUXDB_TAG=2.7
PROMETHEUS_TAG=latest
GRAFANA_TAG=latest
NODE_EXPORTER_TAG=latest
CADVISOR_TAG=latest
PING_EXPORTER_TAG=latest
BLACKBOX_TAG=latest
SPEEDTEST_EXPORTER_TAG=latest
SPEEDTEST_INTERVAL=21600
