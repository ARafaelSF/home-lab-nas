# Gerar em: https://login.tailscale.com/admin/settings/keys
# Recomendado para servidor: Reusable + No expiry + ephemeral=false
# Exemplo: TS_AUTHKEY=tskey-auth-xxxxx?ephemeral=false
TS_AUTHKEY=

# Nome do nó na tailnet (MagicDNS: homelab-docker.tailnet-name.ts.net)
TS_HOSTNAME=homelab-docker

# Tag da imagem (stable ou latest)
TAILSCALE_TAG=stable

# Sub-rede LAN (opcional): aprovar rotas no admin Tailscale após subir
# TS_EXTRA_ARGS=--advertise-routes=192.168.3.0/24
