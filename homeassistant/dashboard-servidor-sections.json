    {
      "type": "grid",
      "cards": [
        {
          "type": "custom:decluttering-card",
          "template": "chip_menu"
        }
      ]
    },
    {
      "type": "grid",
      "cards": [
        {
          "type": "heading",
          "heading": "Servidor",
          "heading_style": "title",
          "icon": "mdi:server",
          "grid_options": {
            "columns": 12,
            "rows": 1
          }
        },
        {
          "square": false,
          "type": "grid",
          "columns": 2,
          "cards": [
            {
              "type": "tile",
              "entity": "switch.escritorio_servidor_minipc_tasmota",
              "name": "Energia do mini PC",
              "icon": "mdi:power-plug",
              "color": "green",
              "features_position": "bottom"
            },
            {
              "type": "tile",
              "entity": "sensor.escritorio_servidor_minipc_potencia_tasmota",
              "name": "Consumo agora",
              "icon": "mdi:flash",
              "color": "amber"
            }
          ],
          "grid_options": {
            "columns": 12,
            "rows": 1
          }
        },
        {
          "type": "custom:mushroom-template-card",
          "primary": "Desligar com segurança",
          "secondary": "Segure ~2 s · depois confirme",
          "icon": "mdi:power",
          "icon_color": "red",
          "multiline_secondary": true,
          "grid_options": {
            "columns": 12,
            "rows": 1
          },
          "tap_action": {
            "action": "none"
          },
          "hold_action": {
            "action": "call-service",
            "service": "script.sistema_homelab_desligar_seguro",
            "confirmation": {
              "text": "Isto vai desligar Home Assistant, a VM Docker e o Proxmox. Tem a certeza?"
            }
          }
        },
        {
          "show_name": true,
          "show_icon": true,
          "type": "button",
          "entity": "switch.escritorio_servidor_minipc_tasmota",
          "grid_options": {
            "columns": 6,
            "rows": 2
          },
          "name": "Servidor MiniPC"
        },
        {
          "show_name": true,
          "show_icon": true,
          "type": "button",
          "entity": "switch.escritorio_estacao_trabalho_sonoff",
          "name": "Estação de Trabalho",
          "icon": "mdi:desk",
          "grid_options": {
            "columns": 6,
            "rows": 2
          }
