# Loads default set of integrations. Do not remove.
default_config:

# Load frontend themes from the themes folder
frontend:
 # Para usar o custom-brand-icons
  extra_module_url:
    - /local/community/custom-brand-icons/custom-brand-icons.js
  themes: !include_dir_merge_named themes

# Text to speech
tts:
  - platform: google_translate

# Configuração SSL - Acesso externo
#http:
#  use_x_forwarded_for: true
#  trusted_proxies:
#    - 172.30.0.0/16
#    - 192.168.3.0/24

# Para conseguir gravar um clip e extrair o frame
ffmpeg:
shell_command:
  # Extrai 1 frame no tempo 1,0 s do clipe MP4 e salva como JPG
  frame_from_clip: >-
    ffmpeg -y -hide_banner -loglevel error
    -ss 00:00:01 -i "{{ src }}" -frames:v 1 "{{ dst }}"
  grafana_render_panel: >-
    curl -sS -f {{ '--insecure' if insecure|default(false) else '' }}
    -H "Authorization: Bearer {{ api_key }}"
    "{{ url }}"
    -o "{{ filename }}"
  grafana_import_geladeira_comparativo: >
    curl -fsS -X POST http://a0d7b954-grafana:3000/api/dashboards/db
    -H "Authorization: Basic ***REDACTED***
    -H "Content-Type: application/json"
    --data-binary @/config/packages/influxdb_energia/grafana_geladeira_midea_comparativo.json
  influx_repair_geladeira_z2m: python3 /config/www/repair_influx_geladeira_z2m.py
  debug_influx_entry: python3 /config/www/debug_influx_entry.py > /config/www/debug_influx_entry.log 2>&1
  cameras_internas_wan_allow: env UNIFI_HOST=192.168.68.1 UNIFI_USERNAME=CursorIA UNIFI_PASSWORD='***REDACTED***' UNIFI_RULE_ID=6a997135a33c069ef0997675 python3 /config/www/unifi_cameras_internas_wan.py allow
  cameras_internas_wan_block: env UNIFI_HOST=192.168.68.1 UNIFI_USERNAME=CursorIA UNIFI_PASSWORD='***REDACTED***' UNIFI_RULE_ID=6a997135a33c069ef0997675 python3 /config/www/unifi_cameras_internas_wan.py block
  docker_ops_update: !secret docker_ops_update_curl

# Replica a protecção no AdGuard backup (Pi). O interruptor nativo só fala com .21.
rest_command:
  adguard_backup_protection:
    url: http://192.168.3.22/control/protection
    method: POST
    username: !secret adguard_username
    password: !secret adguard_password
    content_type: application/json
    verify_ssl: false
    timeout: 8
    payload: '{"enabled": {{ iif(is_on | bool, "true", "false") }} }'
recorder:
  db_url: mysql://homeassistant:***REDACTED***@core-mariadb/homeassistant?charset=utf8mb4
  exclude:
    entities:
    # Ruído de ADC (~100k linhas/6h); o útil é binary_sensor.forno_area_gourmet_chama_acesa
      - sensor.forno_area_gourmet_leitura_chama_adc
    # Gateway UniFi ~1 Hz; histórico fica nos sensores *_(1 min)
      - sensor.escritorio_gateway_unifi_cpu
      - sensor.escritorio_gateway_unifi_memoria
      - sensor.escritorio_gateway_unifi_temperatura
    # Countdown do Pirata atualiza 1/s
      - input_text.pirata_cecilia_tempo_restante
alexa: !include packages/alexa_skill/alexa_skill.yaml

# Climate
climate: !include_dir_merge_list packages/climate/

# MQTT
mqtt: !include_dir_list packages/mqtt

# Media Player
media_player: !include_dir_merge_list packages/media_player/


# Sensores Fake para testes  
# Template - Incluindo Sensores Fake
template: !include_dir_list packages/template
# input_boolean aceita vários arquivos mesclados por nome (dicionário)
input_boolean: !include_dir_merge_named packages/input_boolean

# Probe Geladeira
# Configurações do Core do Home Assistant
homeassistant:
  # Probe Geladeira
  customize:
    # Ajuste do sensor de temperatura 
    sensor.termo_higrometro_geladeira_temperature_probe:
      device_class: temperature
      state_class: measurement

    switch.sistema_home_assistant_sonoff:
      friendly_name: Servidor HomeLab
    sensor.sistema_home_assistant_potencia_sonoff:
      friendly_name: Servidor HomeLab Potência
    sensor.sistema_home_assistant_energia_sonoff:
      friendly_name: Servidor HomeLab Energy
    sensor.sistema_home_assistant_corrente_sonoff:
      friendly_name: Servidor HomeLab Current
    sensor.sistema_home_assistant_tensao_sonoff:
      friendly_name: Servidor HomeLab Voltage
    sensor.sistema_home_assistant_medidor_sonoff:
      friendly_name: Servidor HomeLab



automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml

logger:
  default: info
  logs:
    homeassistant.components.alexa: debug
    homeassistant.components.http: debug # Para ver requisições HTTP
# Histórico elétrico dedicado
influxdb: !include packages/influxdb_energia/influxdb_energia.yaml

# NOTA: referência sanitizada. O ficheiro vivo está em /config/configuration.yaml no HA.
