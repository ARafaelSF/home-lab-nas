# Loads default set of integrations. Do not remove.
default_config:

# Load frontend themes from the themes folder
frontend:
 # Para usar o custom-brand-icons
  extra_module_url:
    - /local/community/custom-brand-icons/custom-brand-icons.js
  themes: !include_dir_merge_named themes

# Text to speech
tts:
  - platform: google_translate

ffmpeg:
alexa: !include packages/alexa_skill/alexa_skill.yaml

# Climate
climate: !include_dir_merge_list packages/climate/

# MQTT
mqtt: !include_dir_list packages/mqtt

# Media Player
media_player: !include_dir_merge_list packages/media_player/

# Sensores Fake para testes
# Template - Incluindo Sensores Fake
template: !include_dir_list packages/template
# input_boolean aceita vários arquivos mesclados por nome (dicionário)
input_boolean: !include_dir_merge_named packages/input_boolean
input_number: !include_dir_merge_named packages/input_number

# Configurações do Core do Home Assistant
homeassistant:
  customize: !include packages/system_customize.yaml
  packages:
    retencao_midias: !include packages/retencao_midias.yaml
    system_commands: !include packages/system_commands.yaml
    system_core: !include packages/system_core.yaml
    
    
automation: !include automations.yaml
script: !include scripts.yaml
scene: !include scenes.yaml

# Histórico elétrico dedicado
influxdb: !include packages/influxdb_energia/influxdb_energia.yaml
notify:
  - name: alexa_notify_me
    platform: rest
    resource: https://api.notifymyecho.com/v1/NotifyMe
    method: POST_JSON
    message_param_name: notification
    title_param_name: title
    data:
      accessCode: !secret alexa_notify_me_access_code
