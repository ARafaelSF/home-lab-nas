# Copiar para /etc/docker/wud-registries.env no servidor Docker (chmod 600).
# Não commitar o ficheiro com token.
#
# O WUD consulta ghcr.io para Immich, Jellyfin, Duplicati, Mealie, Homepage, etc.
# Sem token GitHub válido (ou com token revogado/sem read:packages), o GHCR
# devolve 403/429 e o Home Assistant mostra estado "unknown" nas entidades update.*.
#
# Criar token: GitHub → Settings → Developer settings → Personal access tokens
#   Classic → expiration + scope read:packages (suficiente para imagens públicas)
#   Ou fine-grained: Resource owner = você; Permissions → Packages: Read
#
# Validar (deve imprimir JWT, não 403):
#   source /etc/docker/wud-registries.env
#   curl -s -u "${WUD_REGISTRY_GHCR_PUBLIC_USERNAME}:${WUD_REGISTRY_GHCR_PUBLIC_TOKEN}" \
#     'https://ghcr.io/token?service=ghcr.io&scope=repository:immich-app/immich-server:pull' | head -c 80
#
# Depois: docker compose -f /root/homelab/compose/wud/docker-compose.yml up -d
# O mesmo token serve para GHCR e LSCR (LinuxServer redireciona para GHCR).

WUD_REGISTRY_GHCR_PUBLIC_USERNAME=seu_usuario_github
WUD_REGISTRY_GHCR_PUBLIC_TOKEN=ghp_xxxxxxxx

# Opcional — só se voltar a usar imagens lscr.io/* explicitamente
# WUD_REGISTRY_LSCR_PRIVATE_USERNAME=seu_usuario_github
# WUD_REGISTRY_LSCR_PRIVATE_TOKEN=ghp_xxxxxxxx
