# Copiar para /opt/container-ops/ha-update.env (chmod 600). Não commitar o token real.
DOCKER_OPS_TOKEN=trocar-por-token-longo
LISTEN_HOST=192.168.3.21
LISTEN_PORT=8787
ALLOWED_PREFIXES=192.168.3.10,192.168.3.21,127.0.0.1
HA_WEBHOOK_URL=http://192.168.3.10:8123/api/webhook/docker_ops_update_result
HA_SHUTDOWN_WEBHOOK_URL=http://192.168.3.10:8123/api/webhook/homelab_safe_shutdown_result
# Código = repositório. Dados/logs = /opt/container-ops
CONTAINER_OPS_SH=/root/homelab/scripts/container-ops/ops.sh
CONTAINER_OPS_SHUTDOWN_SH=/root/homelab/scripts/container-ops/safe-shutdown.sh
CONTAINER_OPS_APPS=/root/homelab/scripts/container-ops/apps.conf
CONTAINER_OPS_LOG_DIR=/opt/container-ops/logs
CONTAINER_OPS_DATA=/opt/container-ops
PROXMOX_SSH_HOST=proxmox
PROXMOX_VM_HA=101
PROXMOX_VM_DOCKER=100
